{
  "name": "gg-ecommerce",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter api db:seed",
    "db:init": "pnpm --filter api db:init",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:emit": "pnpm --filter api contract:emit",
    "prisma:init": "pnpm --filter api db:init",
    "stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.expired --forward-to localhost:4000/webhooks/stripe",
    "test:e2e": "playwright test"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.6",
    "prettier-plugin-prisma": "^5.0.0"
  }
}
