# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me
# Test-mode secret key from the Stripe Dashboard (Developers > API keys).
STRIPE_SECRET_KEY=sk_test_...
# Printed by `pnpm stripe:listen` (or `stripe listen --print-secret`).
STRIPE_WEBHOOK_SECRET=whsec_...
