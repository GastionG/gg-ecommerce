// use prisma-next

enum UserRole {
  @@type("pg/text@1")
  USER  = "USER"
  ADMIN = "ADMIN"
}

model Category {
  id        Int                 @id @default(autoincrement())
  slug      String              @unique
  name      String
  createdAt TimestamptzString   @default(now())
  updatedAt temporal.updatedAtString()
}

model Product {
  id          Int                 @id @default(autoincrement())
  slug        String              @unique
  name        String
  description String
  priceCents  Int
  imageUrl    String
  stock       Int                 @default(0)
  category    Category            @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdAt   TimestamptzString   @default(now())
  updatedAt   temporal.updatedAtString()
}

model User {
  id           Int                 @id @default(autoincrement())
  email        String              @unique
  passwordHash String
  role         UserRole            @default(USER)
  createdAt    TimestamptzString   @default(now())
  updatedAt    temporal.updatedAtString()

  @@map("users")
}
