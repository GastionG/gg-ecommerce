// use prisma-next

model Category {
  id        Int               @id @default(autoincrement())
  slug String @unique
  name String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

}

model Product {
  id        Int               @id @default(autoincrement())
  slug String @unique
  name String
  description String
  priceCents Int
  imageUrl String
  stock Int @default(0)
  category    Category          @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
